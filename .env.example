# Database Configuration
# Supported options: 'mysql' or 'sqlite'
# If 'mysql' is selected but unreachable, the application automatically falls back to SQLite.
DB_ENGINE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_library_db

# SQLite Path (used when DB_ENGINE=sqlite or fallback)
SQLITE_PATH=smart_library.db

# Security & Authentication
JWT_SECRET=SMART_LIBRARY_DBMS_SUPER_SECURE_JWT_SECRET_2026

